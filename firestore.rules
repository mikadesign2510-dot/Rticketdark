rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{document} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == 'mika.design2510@gmail.com' || request.auth.token.email == 'admin@admin.com');
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == 'mika.design2510@gmail.com' || request.auth.token.email == 'admin@admin.com');
    }
  }
}
